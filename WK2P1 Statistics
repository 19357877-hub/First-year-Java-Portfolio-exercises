import java.util.Scanner;
public class Main {
  public static void main(String[] args) {
    Scanner kb = new Scanner(System.in);
    int num;
    int min = 999999;
    int max = 0;
    double total = 0;
    for (int i = 0; i < 6; i++){
      System.out.print("Enter an integer: ");
      num = kb.nextInt();
      total += num;
      if (num < min){
        min = num;
      }
      if (num > max){
        max = num;
      }
    }
    System.out.print("min = " + min + " max = " + max + " average = " + (total/6));
  }
}
