public class PopulationComparator implements IComparator{
  public PopulationComparator(){
  }

  public int compare(ITown town1, ITown town2){
    if (town1.getPopulation() > town2.getPopulation()){
      return 1;
    }
    else if (town1.getPopulation() < town2.getPopulation()){
      return -1;
    }
    else{
      return 0;
    }
  }
}
