public class Town implements ITown {
  String name;
  int population;
  double area;

  public Town(String name, int population, double area){
    this.name = name;
    this.population = population;
    this.area = area;
  }

  public String getName(){
    return this.name;
  }

  public int getPopulation(){
    return this.population;
  }

  public double getArea(){
    return this.area;
  }
}
